# Keep every checkout LF-only. The skill ships Markdown, YAML and shell
# snippets; a Windows checkout must not silently rewrite line endings before
# a commit is composed.
* text=auto eol=lf

*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
